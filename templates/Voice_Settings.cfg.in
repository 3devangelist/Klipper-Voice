# =====================================================================
#  Klipper-Voice - SETTINGS
#  Language: @NAME@
#
#  Change a value, then Save & Restart. VOICE VOLUME= and VOICE SPEED= in
#  the console also save their value here.
#  This file is yours: install.sh creates it once and never overwrites it.
#  Need help filling it in? Use PROMPT_AI.md from the repository.
# =====================================================================

[gcode_macro _VOICE_SETTINGS]
# Volume 0..100 (voice and sounds)
variable_volume: 100
# Speaking speed: 1.0 normal, higher = slower
variable_speed: @LENGTH_SCALE@
gcode:

# =====================================================================
#  Bed leveling - only used with Voice/Bed_Level_Voice.cfg (printers with
#  manual bed screws and a probe). Its phrases are in Voice_Messages.cfg.
# =====================================================================

[gcode_macro _BLV_CONFIG]
# --- Bed screws -------------------------------------------------------
# NOZZLE coordinates when the PROBE is over each screw
# (same convention as Klipper's [screws_tilt_adjust]).
#   nozzle X = screw X - probe x_offset
#   nozzle Y = screw Y - probe y_offset
# The 1st screw is the reference (never adjusted).
# Format: [[X, Y, "name"], ...]   - the name is spoken aloud.
# EXAMPLE - REPLACE WITH THE VALUES MEASURED ON YOUR MACHINE:
variable_screws: [[30, 30, "@SCREW1@"], [200, 30, "@SCREW2@"], [200, 200, "@SCREW3@"], [30, 200, "@SCREW4@"]]

# Screw pitch, mm per turn: M3 = 0.5 | M4 = 0.7 | M5 = 0.8
variable_pitch: 0.7
# 1 if "@LV_TIGHTEN@" actually RAISES the bed on your machine
variable_invert: 0

# --- Tuning -----------------------------------------------------------
variable_tolerance: 0.015       # mm accepted as OK (0.015 on M4 ~ 8 degrees)
variable_oks_needed: 2          # consecutive OK readings to move on
variable_max_passes: 4          # full verification passes
variable_pause: 4.0             # seconds between readings (time to hear the phrase)

# --- Preparation ------------------------------------------------------
variable_bed_temp: 60           # bed temperature (0 = no heating)
variable_soak_minutes: 3        # wait after heating
variable_home: "G28"            # homing command (e.g. "G28" or your own macro)
variable_safe_z: 5              # minimum Z (mm) for travel moves
variable_speed_xy: 6000         # mm/min
variable_speed_z: 900           # mm/min

# Console message at the end (empty = none)
variable_next_steps: "@NEXT_STEPS@"

# The spoken phrases are in Voice_Messages.cfg
gcode:
